# ---------------------------------------------------------------------------
# BahaAI — Docker configuration (OPTIONAL)
# ---------------------------------------------------------------------------
# You do NOT need this file to run the app — it works out of the box with
# sensible defaults. Only use it if you want to change something.
#
# HOW TO USE:
#   1. Copy this file to ".env" in the same folder as docker-compose.yml:
#         cp .env.docker.example .env      (macOS/Linux)
#         copy .env.docker.example .env    (Windows)
#   2. Edit the values below.
#   3. Run:  docker compose up --build
#
# Docker Compose reads ".env" automatically. Anything you leave out here
# falls back to the default shown in the comment.
# ---------------------------------------------------------------------------

# --- Web address / port -----------------------------------------------------
# The port on YOUR computer where the app is served.
# If port 8000 is already used by another app, change this to e.g. 8080,
# then open http://localhost:8080  (remember to update APP_URL too).
APP_PORT=8000
APP_URL=http://localhost:8000

# App display name and debug mode.
APP_NAME=BahaAI
APP_DEBUG=true

# --- Database ---------------------------------------------------------------
# These configure the bundled PostgreSQL container. The app and the database
# are kept in sync automatically. You normally don't need to change these.
DB_DATABASE=baha_ai
DB_USERNAME=baha
DB_PASSWORD=secret

# --- Weather (optional) -----------------------------------------------------
# Paste a free OpenWeatherMap API key to show LIVE weather.
# Get one at: https://openweathermap.org/api
# Leave blank to use realistic SIMULATED weather (the app works either way).
OPENWEATHERMAP_API_KEY=

# --- SMS (optional) ---------------------------------------------------------
# "log" (default) records SMS in the notification log WITHOUT sending them, so
# the system demonstrates end-to-end with no account and no credits.
# Set SMS_GATEWAY=semaphore with a key from https://semaphore.co to send real
# messages to Philippine networks (~PHP 0.50 each).
SMS_GATEWAY=log
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# --- Email (real SMTP provider) ---------------------------------------------
# Leave MAIL_MAILER=log to only write emails to storage/logs/laravel.log.
# For real delivery set MAIL_MAILER=smtp and your provider's SMTP details, e.g.
#   Resend: MAIL_HOST=smtp.resend.com  MAIL_PORT=465 MAIL_SCHEME=smtps MAIL_USERNAME=resend MAIL_PASSWORD=re_...
#   Gmail:  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587 MAIL_USERNAME=<you>@gmail.com MAIL_PASSWORD=<16-char app password>
#           (MAIL_FROM_ADDRESS must be that same Gmail address; ~500 emails/day)
#   Brevo:  MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587 MAIL_USERNAME=<login> MAIL_PASSWORD=<smtp key>
# MAIL_FROM_ADDRESS must be on a domain/sender you verified with the provider.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=alerts@baha-ai.tech
